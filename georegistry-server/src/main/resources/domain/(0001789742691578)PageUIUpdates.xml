        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="No source authorities have been registered yet." />
        </attributeStruct>
      </object>

      <object type="com.runwaysdk.localization.LocalizedValueStore" key="rollback.manager.subtitle">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="rollback.manager.subtitle" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Rollback the data imported during this import. This cannot be undone." />
        </attributeStruct>
      </object>

      <object type="com.runwaysdk.localization.LocalizedValueStore" key="scheduledjobs.manager.subtitle">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="scheduledjobs.manager.subtitle" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Track running imports and review completed job history." />
        </attributeStruct>
      </object>
