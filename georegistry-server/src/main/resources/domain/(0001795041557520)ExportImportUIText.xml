<!-- Renames backup and restore to export and import on the system settings page -->
<version xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <createOrUpdate>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Export and Import" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.button">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.button" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Export" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.button">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.button" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Import" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.modal.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.modal.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Export" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.modal.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.modal.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Import instance data" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.sections.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.sections.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Choose the data to include in the export. Data is imported into the organizations and types on the target server, so include Organizations and Types and hierarchy definitions unless they already exist there." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.users.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.users.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="The export will include all users along with their profile information and roles, but not their passwords. When the export is imported, any user that does not already exist will be given a randomly generated password and must reset their password before they can log in." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.users.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.users.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Users in the export will be imported with their profile information and roles. Passwords are not included in exports: any user that does not already exist will be given a randomly generated password and must reset their password before they can log in, while existing users keep their current password. The admin account and your own account will not be changed." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Import complete" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.empty">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.empty" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="The file did not contain any data to import." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.lists">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.lists" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Lists are not built automatically by an import. You may need to refresh or publish the lists before their data is visible." />
        </attributeStruct>
      </object>
    </createOrUpdate>
  </doIt>
  <undoIt>
    <createOrUpdate>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Backup and Restore" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.button">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.button" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Backup" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.button">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.button" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Restore" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.modal.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.modal.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Backup" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.modal.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.modal.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Restore instance data" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.sections.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.sections.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Choose the data to include in the backup. Data is restored into the organizations and types on the target server, so include Organizations and Types and hierarchy definitions unless they already exist there." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.backup.users.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.backup.users.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="The backup will include all users along with their profile information and roles, but not their passwords. When the backup is restored, any user that does not already exist will be given a randomly generated password and must reset their password before they can log in." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.users.message">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.users.message" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Users in the backup will be restored with their profile information and roles. Passwords are not included in backups: any user that does not already exist will be given a randomly generated password and must reset their password before they can log in, while existing users keep their current password. The admin account and your own account will not be changed." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.title">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.title" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Restore complete" />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.empty">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.empty" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="The backup did not contain any data to restore." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="settings.restore.complete.lists">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="settings.restore.complete.lists" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Lists are not built automatically by a restore. You may need to refresh or publish the lists before their data is visible." />
        </attributeStruct>
      </object>
    </createOrUpdate>
  </undoIt>
</version>
