<version xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <create>
      <mdEdge name="net.geoprism.registry.graph.ExternalID" label="Alternative Id" parent="net.geoprism.registry.graph.SourceAuthority" child="net.geoprism.registry.graph.GeoVertex" generateSource="false">
        <attributes>
          <text name="id" label="ID" required="true" />
          <text name="key" required="true" indexType="unique index" />          
        </attributes>      
      </mdEdge>
      <mdException name="net.geoprism.registry.exception.DuplicateExternalIdException" message="The Alternative Id [{externalId}] is already mapped to the source authority [{externalSystem}].">
        <attributes>
          <text name="externalId"/>
          <text name="externalSystem"/>
        </attributes>
      </mdException>
       
    </create>
    <permissions>
      <role roleName="geoprism.admin.Administrator">
        <grant>
          <mdRelationshipPermission type="net.geoprism.registry.graph.ExternalID">
            <operation name="ALL" />
          </mdRelationshipPermission>                    
        </grant>
      </role>      
      <role roleName="cgr.RegistryMaintainer">
        <grant>
          <mdRelationshipPermission type="net.geoprism.registry.graph.ExternalID">
            <operation name="ALL" />
          </mdRelationshipPermission>                    
        </grant>
      </role>      
      <role roleName="cgr.RegistryContributor">
        <grant>
          <mdRelationshipPermission type="net.geoprism.registry.graph.ExternalID">
            <operation name="READ" />
            <operation name="READ_ALL_ATTRIBUTES" />
          </mdRelationshipPermission>                    
        </grant>
      </role>      
      <role roleName="cgr.APIConsumer">
        <grant>
          <mdRelationshipPermission type="net.geoprism.registry.graph.ExternalID">
            <operation name="READ" />
            <operation name="READ_ALL_ATTRIBUTES" />
          </mdRelationshipPermission>                    
        </grant>
      </role>      
      
    </permissions>
  </doIt>
  <undoIt>
    <delete>
      <object type="com.runwaysdk.system.metadata.MdEdge" key="net.geoprism.registry.graph.ExternalID"/>    
    </delete>
  </undoIt>
</version>