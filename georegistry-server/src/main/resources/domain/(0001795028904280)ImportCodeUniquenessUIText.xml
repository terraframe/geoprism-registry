<!-- Explains the scope in which a code must be unique, shown in the tooltip of the code attribute when matching import columns -->
<version xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <createOrUpdate>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.GEO_OBJECT">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="io.attributes.codeUnique.GEO_OBJECT" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Codes must be unique within this Geo-Object type." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.BUSINESS_OBJECT">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="io.attributes.codeUnique.BUSINESS_OBJECT" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Codes must be unique within this business type." />
        </attributeStruct>
      </object>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.CONCEPT_OBJECT">
        <attribute name="storeTag" value="UIText" />
        <attribute name="storeKey" value="io.attributes.codeUnique.CONCEPT_OBJECT" />
        <attributeStruct name="storeValue">
          <attribute name="defaultLocale" value="Codes must be unique across all concepts." />
        </attributeStruct>
      </object>
    </createOrUpdate>
  </doIt>
  <undoIt>
    <delete>
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.GEO_OBJECT" />
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.BUSINESS_OBJECT" />
      <object type="com.runwaysdk.localization.LocalizedValueStore" key="io.attributes.codeUnique.CONCEPT_OBJECT" />
    </delete>
  </undoIt>
</version>
